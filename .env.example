# Copy to .env and fill in. The app runs without it; Slack sending needs it.
# Slack App -> Basic Information -> App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://<your-tunnel-host>/slack/oauth/callback

# Required by POST /slack/events (Events API signature verification).
# Slack App -> Basic Information -> App Credentials -> Signing Secret.
# Without it every event is rejected with 401 (the send path still works).
SLACK_SIGNING_SECRET=

# Fallback channel when config/slack_routes.json has no entry for a region.
# See config/README.md: the app must be invited to the channel for events.
SLACK_CHANNEL_ID=

# Fallback mentions (comma-separated Slack member IDs such as U0123456789).
SLACK_MENTION_USER_IDS=
