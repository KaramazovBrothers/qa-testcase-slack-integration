# Copy to .env and fill in. The app runs without it; Slack sending needs it.
# Slack App -> Basic Information -> App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://<your-tunnel-host>/slack/oauth/callback

# Required by POST /slack/events (Events API signature verification).
# Slack App -> Basic Information -> App Credentials -> Signing Secret.
# Without it every event is rejected with 401 (the send path still works).
SLACK_SIGNING_SECRET=

# Fallback channel when config/slack_routes.json has no entry for a region.
# See config/README.md: the app must be invited to the channel for events.
SLACK_CHANNEL_ID=

# Fallback mentions (comma-separated Slack member IDs such as U0123456789).
SLACK_MENTION_USER_IDS=

# Storage. Leave empty to keep the local SQLite file (data/qa_tests.db).
# Any libpq URL switches the app to PostgreSQL:
#   QAHELPER_DATABASE_URL=postgresql://user:password@host:5432/qahelper
# On first start the schema is created and an existing data/qa_tests.db is
# imported once (rows keep their ids). Tests run on PostgreSQL too:
#   QAHELPER_TEST_DATABASE_URL=postgresql:///qahelper_test \
#     .venv/bin/python -m unittest discover -s tests

# --- Deployment (docker compose) -------------------------------------------
# The container reads this file via `env_file`. Copy it to `.env` next to
# `docker-compose.yml`, fill in the values, and keep it out of git (already
# ignored).
#
# PostgreSQL used by the container. On the local `demo` profile the address is
# `db` (the compose service name); in production point it at the managed
# instance:
#   QAHELPER_DATABASE_URL=postgresql://qahelper:<password>@<host>:5432/qahelper?sslmode=require

# `proxy` when the app runs behind the corporate reverse proxy that performs
# SSO. Leave empty for a standalone/pilot installation (single QA user).
QAHELPER_ACCESS_MODE=

# Header the proxy sets with the authenticated person's identity. Only used
# with QAHELPER_ACCESS_MODE=proxy.
QAHELPER_IDENTITY_HEADER=x-auth-request-email

# Slack channel that receives WebView build requests.
QAHELPER_WEBVIEW_CHANNEL=
