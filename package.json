{
  "name": "qa-testcase-slack-integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend source of the QA testcase generator. Python serves the built output.",
  "scripts": {
    "build": "python3 scripts/build_static.py",
    "build:check": "python3 scripts/build_static.py --check",
    "test": "node --test tests/js/*.test.js",
    "test:parity": "node tests/js/parity-with-legacy.mjs \"$LEGACY_GENERATOR\"",
    "test:features": "node tests/js/feature-parity.mjs \"$LEGACY_GENERATOR\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
